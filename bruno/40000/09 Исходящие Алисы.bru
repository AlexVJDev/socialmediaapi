meta {
  name: Исходящие Алисы
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/friendship-offer?direction=OUTGOING
  body: none
  auth: none
}

headers {
  X-User-Id: {{aliceId}}
}

tests {
  test("статус 200", function() {
    expect(res.status).to.equal(200);
  });

  test("заявка Алисы Борису", function() {
    expect(res.body.offers.map(i => i.id)).to.eql([bru.getVar("offerAlice")]);
    expect(res.body.next).to.equal(null);
  });
}
