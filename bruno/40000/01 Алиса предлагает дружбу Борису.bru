meta {
  name: Алиса предлагает дружбу Борису
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/friendship-offer/create
  body: json
  auth: none
}

body:json {
  {"fromUserId": "{{aliceId}}", "toUserId": "{{borisId}}"}
}

script:pre-request {
  // Новые пользователи на каждый прогон: коллекцию можно запускать повторно.
  const uuid = () => "xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx".replace(/x/g, () => Math.floor(Math.random() * 16).toString(16));
  bru.setVar("aliceId", uuid());
  bru.setVar("borisId", uuid());
  bru.setVar("vikaId", uuid());
  bru.setVar("dimaId", uuid());
}

script:post-response {
  bru.setVar("offerAlice", res.body.id);
}

tests {
  test("статус 201", function() {
    expect(res.status).to.equal(201);
  });
}
