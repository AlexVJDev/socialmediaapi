meta {
  name: Дима предлагает дружбу Борису
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/friendship-offer/create
  body: json
  auth: none
}

body:json {
  {"fromUserId": "{{dimaId}}", "toUserId": "{{borisId}}"}
}

script:post-response {
  bru.setVar("offerDima", res.body.id);
}

tests {
  test("статус 201", function() {
    expect(res.status).to.equal(201);
  });
}
