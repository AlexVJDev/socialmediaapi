meta {
  name: Борис отклоняет заявку Вики
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/friendship-offer/reject
  body: json
  auth: none
}

headers {
  X-User-Id: {{borisId}}
}

body:json {
  {"offerId": "{{offerVika}}"}
}

tests {
  test("статус 200", function() {
    expect(res.status).to.equal(200);
  });

  test("REJECTED, есть rejectedAt", function() {
    expect(res.body.status).to.equal("REJECTED");
    expect(res.body.rejectedAt).to.be.a("string");
  });
}
