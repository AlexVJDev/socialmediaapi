meta {
  name: Алиса принимает свою заявку
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/friendship-offer/accept
  body: json
  auth: none
}

headers {
  X-User-Id: {{aliceId}}
}

body:json {
  {"offerId": "{{offerAlice}}"}
}

tests {
  test("статус 404", function() {
    expect(res.status).to.equal(404);
  });

  test("code = FRIENDSHIP_OFFER_NOT_FOUND", function() {
    expect(res.body.code).to.equal("FRIENDSHIP_OFFER_NOT_FOUND");
  });
}
