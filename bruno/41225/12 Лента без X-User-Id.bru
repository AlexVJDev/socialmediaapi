meta {
  name: Лента без X-User-Id
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/feed
  body: none
  auth: none
}

tests {
  test("статус 401", function() {
    expect(res.status).to.equal(401);
  });

  test("тело ответа", function() {
    expect(res.body.code).to.equal("UNAUTHORIZED");
  });
}
