meta {
  name: Повторная подписка
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/subscribes
  body: json
  auth: none
}

headers {
  X-User-Id: {{aliceId}}
}

body:json {
  {
    "userId": "{{borisId}}"
  }
}

tests {
  test("статус 200", function() {
    expect(res.status).to.equal(200);
  });

  test("тело ответа", function() {
    expect(res.body.id).to.equal(bru.getVar("subscriptionId"));
  });
}
