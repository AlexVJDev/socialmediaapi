meta {
  name: Создать пост с пустым title
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/posts
  body: json
  auth: none
}

headers {
  X-User-Id: {{borisId}}
}

body:json {
  {
    "title": "   ",
    "content": "Текст"
  }
}

tests {
  test("статус 400", function() {
    expect(res.status).to.equal(400);
  });

  test("тело ответа", function() {
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });
}
