meta {
  name: Изменить чужой пост Алисой
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/posts/{{postId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{aliceId}}
}

body:json {
  {
    "title": "Чужой",
    "content": "Чужой"
  }
}

tests {
  test("статус 404", function() {
    expect(res.status).to.equal(404);
  });

  test("тело ответа", function() {
    expect(res.body.code).to.equal("POST_NOT_FOUND");
  });
}
