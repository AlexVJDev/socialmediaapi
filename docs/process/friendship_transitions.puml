@startuml
title Friendship request change scenarios

skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  ActorBorderColor #334155
  LifeLineBorderColor #CBD5E1
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F8FAFC
  ParticipantFontColor #0F172A
}

actor "Alice\nrequest initiator" as Alice
actor "Boris\nrequest recipient" as Boris
participant "FriendRequestController" as Controller
participant "FriendRequestService" as Service
participant "FriendRequestRepository" as Repository
database DB

== Create friendship request ==

Alice -> Controller : create(fromUserId = Alice, toUserId = Boris)
Controller -> Service : createOffer(Alice, Boris)
Service -> Repository : findByUsers(Alice, Boris)
Repository -> DB : SELECT friend_request
DB --> Repository : existing request or empty result
Repository --> Service : existing request or empty result

alt no existing request
  Service -> Repository : save(status = PENDING)
  Repository -> DB : INSERT friend_request(PENDING)
  DB --> Repository : created request
  Repository --> Service : FriendRequest(PENDING)
  Service -> Repository : ensure subscription Alice -> Boris
  Repository -> DB : INSERT subscription if absent
  DB --> Repository : subscription exists
  Repository --> Service : subscription result
  Service --> Controller : created PENDING request
  Controller --> Alice : 201 Created, status = PENDING
else existing request status = PENDING
  Service --> Controller : existing PENDING request
  Controller --> Alice : 200 OK, status = PENDING, duplicate is not created
else existing request status = ACCEPTED
  Service --> Controller : already accepted result
  Controller --> Alice : 200 OK, status = ACCEPTED, friendship state is unchanged
else existing request status = REJECTED
  Service --> Controller : conflict: cannot return to PENDING automatically
  Controller --> Alice : 409 Conflict
end

== Accept friendship request ==

Boris -> Controller : accept(fromUserId = Alice, toUserId = Boris)
Controller -> Service : acceptOffer(Alice, Boris)
Service -> Repository : findByUsers(Alice, Boris)
Repository -> DB : SELECT friend_request
DB --> Repository : request or empty result
Repository --> Service : request or empty result

alt request exists and status = PENDING
  Service -> Repository : save(status = ACCEPTED)
  Repository -> DB : UPDATE friend_request SET status = ACCEPTED
  DB --> Repository : updated request
  Repository --> Service : FriendRequest(ACCEPTED)
  Service -> Repository : ensure friendship Alice <-> Boris
  Repository -> DB : INSERT mutual friendship if absent
  DB --> Repository : friendship exists
  Repository --> Service : friendship result
  Service -> Repository : ensure subscription Boris -> Alice
  Repository -> DB : INSERT reverse subscription if absent
  DB --> Repository : subscription exists
  Repository --> Service : subscription result
  Service --> Controller : accepted request
  Controller --> Boris : 200 OK, status = ACCEPTED
else request exists and status = ACCEPTED
  Service --> Controller : already accepted result
  Controller --> Boris : 200 OK, status = ACCEPTED, duplicate changes are not created
else request exists and status = REJECTED
  Service --> Controller : conflict: rejected request cannot be accepted
  Controller --> Boris : 409 Conflict
else request not found
  Service --> Controller : request was not found
  Controller --> Boris : 404 Not Found
end

== Reject friendship request ==

Boris -> Controller : reject(fromUserId = Alice, toUserId = Boris)
Controller -> Service : rejectOffer(Alice, Boris)
Service -> Repository : findByUsers(Alice, Boris)
Repository -> DB : SELECT friend_request
DB --> Repository : request or empty result
Repository --> Service : request or empty result

alt request exists and status = PENDING
  Service -> Repository : save(status = REJECTED)
  Repository -> DB : UPDATE friend_request SET status = REJECTED
  DB --> Repository : updated request
  Repository --> Service : FriendRequest(REJECTED)
  Service --> Controller : rejected request
  Controller --> Boris : 200 OK, status = REJECTED
else request exists and status = REJECTED
  Service --> Controller : already rejected result
  Controller --> Boris : 200 OK, status = REJECTED, duplicate changes are not created
else request exists and status = ACCEPTED
  Service --> Controller : conflict: accepted request cannot be rejected
  Controller --> Boris : 409 Conflict
else request not found
  Service --> Controller : request was not found
  Controller --> Boris : 404 Not Found
end

== Action matrix ==

legend bottom
|= Action |= Initiator |= Precondition |= Result |
| Create request | Request initiator | There is no request between users | Request is created with PENDING status; initiator subscribes to recipient |
| Re-create request | Request initiator | Existing request status is PENDING | Existing request is returned; duplicate request and subscription are not created |
| Re-create request | Request initiator | Existing request status is ACCEPTED | Existing result is returned; friendship and subscriptions are unchanged |
| Re-create request | Request initiator | Existing request status is REJECTED | Operation ends with conflict; request is not moved back to PENDING |
| Accept request | Request recipient | Existing request status is PENDING | Request changes to ACCEPTED; friendship and reverse subscription are created if absent |
| Accept request again | Request recipient | Existing request status is ACCEPTED | Existing result is returned; duplicate friendship and subscription are not created |
| Accept rejected request | Request recipient | Existing request status is REJECTED | Operation ends with conflict |
| Reject request | Request recipient | Existing request status is PENDING | Request changes to REJECTED; friendship and reverse subscription are not created |
| Reject request again | Request recipient | Existing request status is REJECTED | Existing result is returned; data is unchanged |
| Reject accepted request | Request recipient | Existing request status is ACCEPTED | Operation ends with conflict |
endlegend
@enduml
