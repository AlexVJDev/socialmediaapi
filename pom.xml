<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ru.job4j</groupId>
	<artifactId>social-media-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<spring-modulith.version>2.1.1</spring-modulith.version>
		<openapi-generator.version>7.27.0</openapi-generator.version>
		<!-- OpenAPI generation, common to all modules: an execution's importMappings replaces the plugin's one,
		     so every module's openapi.<module>.imports starts with ${openapi.common.imports}. -->
		<openapi.common.imports>Instant=java.time.Instant</openapi.common.imports>
		<!-- OpenAPI generation of module friendships (see openapi-generator-maven-plugin) -->
		<openapi.friendships.spec>${project.basedir}/docs/api/modules/friendships.yaml</openapi.friendships.spec>
		<openapi.friendships.package>ru.job4j.socialmediaapi.friendships.internal.infrastructure.web</openapi.friendships.package>
		<openapi.friendships.requests>CreateFriendshipOfferWebRequest,AcceptFriendshipOfferWebRequest,RejectFriendshipOfferWebRequest</openapi.friendships.requests>
		<openapi.friendships.responses>CreateFriendshipOfferWebResponse,AcceptFriendshipOfferWebResponse,RejectFriendshipOfferWebResponse,friendship-offer,FriendshipOfferPageWebResponse,FriendshipOfferCursorWebResponse,FriendWebResponse</openapi.friendships.responses>
		<openapi.friendships.inline-names>
			createFriendshipOffer_request=CreateFriendshipOfferWebRequest,
			acceptFriendshipOffer_request=AcceptFriendshipOfferWebRequest,
			rejectFriendshipOffer_request=RejectFriendshipOfferWebRequest,
			createFriendshipOffer_201_response=CreateFriendshipOfferWebResponse,
			acceptFriendshipOffer_200_response=AcceptFriendshipOfferWebResponse,
			rejectFriendshipOffer_200_response=RejectFriendshipOfferWebResponse,
			getFriendshipOffers_200_response=FriendshipOfferPageWebResponse,
			getFriendshipOffers_200_response_next=FriendshipOfferCursorWebResponse,
			getFriends_200_response_inner=FriendWebResponse
		</openapi.friendships.inline-names>
		<!-- Names of the schemas from docs/api/schemas/*.yaml (the schema is named by its file).
		     modelsToGenerate takes the file name (friendship-offer), not the mapped one. -->
		<openapi.friendships.model-names>friendship-offer=FriendshipOfferWebResponse</openapi.friendships.model-names>
		<!-- Error bodies -> shared.web.ErrorResponse (written by the exception handlers, not generated):
		     every error response refers to docs/api/schemas/error.yaml (schema "error").
		     createFriendshipOffer_200_response is the FRIENDSHIP_OFFER_ALREADY_PENDING error body too, but it stays inline:
		     the generator takes the return type from the lowest 2xx code (200, not 201), so it is mapped to the 201 type
		     and the method returns the created offer; the 200 body is written by FriendshipOfferExceptionHandler. -->
		<openapi.friendships.schemas>
			createFriendshipOffer_200_response=CreateFriendshipOfferWebResponse,
			error=ErrorResponse
		</openapi.friendships.schemas>
		<!-- Types imported by *-api: DTOs of the module (generated by *-requests / *-responses) and ErrorResponse -->
		<openapi.friendships.imports>
			${openapi.common.imports},
			ErrorResponse=ru.job4j.socialmediaapi.shared.web.ErrorResponse,
			CreateFriendshipOfferWebRequest=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.request.CreateFriendshipOfferWebRequest,
			AcceptFriendshipOfferWebRequest=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.request.AcceptFriendshipOfferWebRequest,
			RejectFriendshipOfferWebRequest=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.request.RejectFriendshipOfferWebRequest,
			CreateFriendshipOfferWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.CreateFriendshipOfferWebResponse,
			AcceptFriendshipOfferWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.AcceptFriendshipOfferWebResponse,
			RejectFriendshipOfferWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.RejectFriendshipOfferWebResponse,
			FriendshipOfferWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.FriendshipOfferWebResponse,
			FriendshipOfferPageWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.FriendshipOfferPageWebResponse,
			FriendshipOfferCursorWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.FriendshipOfferCursorWebResponse,
			FriendWebResponse=ru.job4j.socialmediaapi.friendships.internal.infrastructure.web.response.FriendWebResponse
		</openapi.friendships.imports>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<version>4.1.1</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.14</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TestRestTemplate for E2E tests over a real HTTP port (moved out of spring-boot-test in Boot 4) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- RestTemplateBuilder needed by TestRestTemplate; the application itself has no HTTP client -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<violationSeverity>warning</violationSeverity>
					<!-- only hand-written code: skip MapStruct output in target/generated-sources -->
					<sourceDirectories>
						<sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
					</sourceDirectories>
					<testSourceDirectories>
						<testSourceDirectory>${project.build.testSourceDirectory}</testSourceDirectory>
					</testSourceDirectories>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Spring interfaces of the controllers and web DTOs from the contract docs/api.
			     Output: target/generated-sources/openapi (added to the compile sources, not checked by Checkstyle).
			     Input of a module: docs/api/modules/<module>.yaml — the module's paths of docs/api/openapi.yaml.
			     One execution generates one package, so each module has three executions:
			       *-api        interface <Tag>Api  -> <module>.internal.infrastructure.web (controllers implement it)
			       *-requests   *WebRequest         -> <module>.internal.infrastructure.web.request
			       *-responses  *WebResponse        -> <module>.internal.infrastructure.web.response
			     Names of inline schemas (<operationId>_request, <operationId>_<code>_response) are set by
			     inlineSchemaNameMappings; *-api imports the module's DTOs by importMappings. Error bodies are not
			     generated: exception handlers answer with shared.web.ErrorResponse. The settings of a module are kept
			     in properties openapi.<module>.*; schemaMappings/importMappings are given only to *-api: in the model
			     executions they would skip the mapped models. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<configuration>
					<generatorName>spring</generatorName>
					<generateSupportingFiles>false</generateSupportingFiles>
					<generateApiTests>false</generateApiTests>
					<generateModelTests>false</generateModelTests>
					<generateApiDocumentation>false</generateApiDocumentation>
					<generateModelDocumentation>false</generateModelDocumentation>
					<!-- the application works with Instant; JSON stays ISO-8601 in UTC -->
					<typeMappings>DateTime=Instant</typeMappings>
					<importMappings>${openapi.common.imports}</importMappings>
					<configOptions>
						<!-- Java files directly in target/generated-sources/openapi (not in .../src/main/java):
						     IntelliJ marks every target/generated-sources/* folder as a generated source root on Maven
						     reload, so the packages must start right there, as in target/generated-sources/annotations.
						     Maven adds the same folder to the compile sources. -->
						<sourceFolder>.</sourceFolder>
						<useSpringBoot4>true</useSpringBoot4>
						<interfaceOnly>true</interfaceOnly>
						<!-- no default methods: a controller must implement every operation of its interface -->
						<skipDefaultInterface>true</skipDefaultInterface>
						<useTags>true</useTags>
						<useBeanValidation>true</useBeanValidation>
						<openApiNullable>false</openApiNullable>
						<!-- null handling of JSON is left to the global ObjectMapper (no @JsonInclude / @JsonSetter
						     on fields); set explicitly, otherwise the generator warns on every execution -->
						<generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
						<generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
						<annotationLibrary>none</annotationLibrary>
						<documentationProvider>none</documentationProvider>
						<hideGenerationTimestamp>true</hideGenerationTimestamp>
					</configOptions>
				</configuration>
				<executions>
					<!-- module friendships -->
					<execution>
						<id>friendships-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.friendships.spec}</inputSpec>
							<apiPackage>${openapi.friendships.package}</apiPackage>
							<generateModels>false</generateModels>
							<inlineSchemaNameMappings>${openapi.friendships.inline-names}</inlineSchemaNameMappings>
							<modelNameMappings>${openapi.friendships.model-names}</modelNameMappings>
							<schemaMappings>${openapi.friendships.schemas}</schemaMappings>
							<importMappings>${openapi.friendships.imports}</importMappings>
						</configuration>
					</execution>
					<execution>
						<id>friendships-requests</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.friendships.spec}</inputSpec>
							<modelPackage>${openapi.friendships.package}.request</modelPackage>
							<generateApis>false</generateApis>
							<modelsToGenerate>${openapi.friendships.requests}</modelsToGenerate>
							<inlineSchemaNameMappings>${openapi.friendships.inline-names}</inlineSchemaNameMappings>
							<modelNameMappings>${openapi.friendships.model-names}</modelNameMappings>
						</configuration>
					</execution>
					<execution>
						<id>friendships-responses</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.friendships.spec}</inputSpec>
							<modelPackage>${openapi.friendships.package}.response</modelPackage>
							<generateApis>false</generateApis>
							<modelsToGenerate>${openapi.friendships.responses}</modelsToGenerate>
							<inlineSchemaNameMappings>${openapi.friendships.inline-names}</inlineSchemaNameMappings>
							<modelNameMappings>${openapi.friendships.model-names}</modelNameMappings>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- The OpenAPI output as an explicit source root. Maven already compiles it (the generator adds it),
			     but IntelliJ does not run the generator on Maven reload and may miss the folder; build-helper's
			     configuration is read by IntelliJ directly from the pom, so the folder is always a source root. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-openapi-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/openapi</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- mapper: -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<!-- если уже используется: -->
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
